  "id": "t18",
  "title": "挿入ソートで要素をずらす",
  "tags": [
   "整列",
   "二重ループ"
  ],
  "terms": [
   "挿入ソート"
  ],
  "algo": "insertion-sort",
  "code": [
   "○insertionSort(整数型の配列: data)",
   "  整数型: i, j, key",
   "  for (i を 2 から dataの要素数 まで 1 ずつ増やす)",
   "    key ← data[i]",
   "    j ← i - 1",
   "    while (j ≧ 1 and data[j] > key)",
   "      data[j + 1] ← data[j]",
   "      j ← j - 1",
   "    endwhile",
   "    data[j + 1] ← key",
   "  endfor"
  ],
  "main": [
   "整数型の配列: a ← {4, 3, 5, 1}",
   "insertionSort(a)",
   "print(a)"
  ],
  "line": 8,
  "vars": [
   "i",
   "j",
   "key"
  ],
  "hint": "8行目は、key より大きい要素を1つ後ろへずらしたときだけ実行されます。i = 3 のときは data[2] = 4 が key = 5 より小さいので、1回もずらしません。"
 },

  "code": [
   "○reverse(整数型の配列: data)",
   "  整数型: left ← 1",
   "  整数型: right ← dataの要素数",
   "  整数型: tmp",
   "  while (left < right)",
   "    tmp ← data[left]",
   "    data[left] ← data[right]",
   "    data[right] ← tmp",
   "    left ← left + 1",
   "    right ← right - 1",
   "  endwhile"
  ],
  "main": [
   "整数型の配列: a ← {1, 2, 3, 4, 5}",
   "reverse(a)",
   "print(a)"
  ],
  "line": 10,
  "vars": [
   "left",
   "right",
   "tmp"
  ],
  "hint": "left と right が両端から1つずつ近づき、left < right でなくなったら終わります。"
 },
 {
  "id": "t8",
  "title": "最大公約数（互除法）",
  "tags": [
   "ループ",
   "計算"
  ],
  "terms": [],
  "algo": "gcd",
  "code": [
   "○整数型: gcd(整数型: a, 整数型: b)",
   "  整数型: r",
   "  while (b ≠ 0)",
   "    r ← a mod b",
   "    a ← b",
   "    b ← r",
   "  endwhile",
   "  return a"
  ],
  "main": [
   "print(gcd(48, 18))"
  ],
  "line": 6,
  "vars": [
   "a",
   "b",
   "r"
  ],
  "hint": "48 mod 18 は 48 を 18 で割った余りで 12。そのあと a と b が1つずつずれていきます。"
 }

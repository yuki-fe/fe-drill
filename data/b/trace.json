   "  while (b ≠ 0)",
   "    r ← a mod b",
   "    a ← b",
   "    b ← r",
   "  endwhile",
   "  return a"
  ],
  "main": [
   "print(gcd(48, 18))"
  ],
  "line": 6,
  "vars": [
   "a",
   "b",
   "r"
  ],
  "hint": "48 mod 18 は 48 を 18 で割った余りで 12。そのあと a と b が1つずつずれていきます。"
 },

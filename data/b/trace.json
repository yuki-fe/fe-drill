  "code": [
   "○整数型: digitSum(整数型: n)",
   "  整数型: sum ← 0",
   "  while (n > 0)",
   "    sum ← sum + (n mod 10)",
   "    n ← n ÷ 10",
   "  endwhile",
   "  return sum"
  ],
  "main": [
   "print(digitSum(4721))"
  ],
  "line": 5,
  "vars": [
   "n",
   "sum"
  ],
  "hint": "n mod 10 は一の位の数字、n ÷ 10 は一の位を取り除いた数（商）です。"
 },

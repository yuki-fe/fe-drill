  "title": "二分探索の範囲を追う",
  "tags": [
   "探索",
   "ループ"
  ],
  "terms": [
   "二分探索"
  ],
  "algo": "binary-search",
  "code": [
   "○整数型: binarySearch(整数型の配列: data, 整数型: target)",
   "  整数型: low ← 1",
   "  整数型: high ← dataの要素数",
   "  整数型: mid",
   "  while (low ≦ high)",
   "    mid ← (low + high) ÷ 2",
   "    if (data[mid] = target)",
   "      return mid",
   "    elseif (data[mid] < target)",
   "      low ← mid + 1",
   "    else",
   "      high ← mid - 1",
   "    endif",
   "  endwhile",
   "  return -1"
  ],
  "main": [
   "print(binarySearch({3, 8, 11, 15, 20, 26, 31, 40}, 11))"
  ],
  "line": 6,
  "vars": [
   "low",
   "high",
   "mid"
  ],
  "hint": "(1 + 8) ÷ 2 は 4（小数点以下を切り捨て）。data[4] = 15 は 11 より大きいので、次は high が変わります。"
 },
